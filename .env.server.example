# Port 3014 and production mode are set by ecosystem.config.cjs.
DATA_DIR=/var/lib/nkriz-notepad
DATABASE_URL=postgresql://nkriz:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/nkriz?schema=public
SESSION_PEPPER=REPLACE_WITH_A_STABLE_RANDOM_PEPPER
FRONTEND_ORIGIN=https://workspace.nkriz.ir
SERVE_WEB=false

# Keep these true when workspace.nkriz.ir reaches the app through an HTTPS proxy.
COOKIE_SECURE=true
TRUST_PROXY=true

MAX_FILE_BYTES=104857600
MAX_STORAGE_BYTES=10737418240
