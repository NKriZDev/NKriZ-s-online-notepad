# Optional Docker Compose overrides. Docker works without this file.
# Copy this file to .env.docker and use URL-safe characters for the password.
APP_PORT=8787
POSTGRES_DB=nkriz
POSTGRES_USER=nkriz
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password

# Leave this unset to generate a random pepper in the persistent app_data volume.
# Set it to the same value when restoring a database without its app_data volume.
# DOCKER_SESSION_PEPPER=replace-with-at-least-32-random-bytes

# Enable both when an HTTPS reverse proxy terminates TLS in front of the app.
DOCKER_COOKIE_SECURE=false
DOCKER_TRUST_PROXY=false

DOCKER_MAX_FILE_BYTES=104857600
DOCKER_MAX_STORAGE_BYTES=10737418240
