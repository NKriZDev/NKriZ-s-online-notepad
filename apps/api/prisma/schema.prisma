generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 Int      @id
  username           String   @unique @db.VarChar(80)
  authVerifier       String   @map("auth_verifier") @db.VarChar(128)
  recoveryVerifier   String   @map("recovery_verifier") @db.VarChar(128)
  authSalt           String   @map("auth_salt") @db.VarChar(128)
  passwordEnvelope   String   @map("password_envelope") @db.Text
  recoveryEnvelope   String   @map("recovery_envelope") @db.Text
  kdfParams          String   @map("kdf_params") @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("account")
}

model Session {
  tokenHash String   @id @map("token_hash") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("sessions")
}

model VaultRecord {
  id         String           @id @db.Uuid
  revision   Int
  deleted    Boolean          @default(false)
  ciphertext String           @db.Text
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  revisions  RecordRevision[]

  @@map("records")
}

model RecordRevision {
  recordId   String      @map("record_id") @db.Uuid
  revision   Int
  deleted    Boolean
  ciphertext String      @db.Text
  changedAt  DateTime    @default(now()) @map("changed_at")
  record     VaultRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@id([recordId, revision])
  @@index([recordId, revision(sort: Desc)])
  @@map("record_revisions")
}

model Change {
  seq        Int      @id @default(autoincrement())
  recordId   String   @map("record_id") @db.Uuid
  revision   Int
  deleted    Boolean
  ciphertext String   @db.Text
  changedAt  DateTime @default(now()) @map("changed_at")

  @@index([seq])
  @@map("changes")
}

model Blob {
  id         String      @id @db.Uuid
  byteSize   BigInt      @map("byte_size")
  chunkSize  Int         @map("chunk_size")
  chunkCount Int         @map("chunk_count")
  completed  Boolean     @default(false)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  chunks     BlobChunk[]

  @@map("blobs")
}

model BlobChunk {
  blobId     String   @map("blob_id") @db.Uuid
  chunkIndex Int      @map("chunk_index")
  byteSize   Int      @map("byte_size")
  createdAt  DateTime @default(now()) @map("created_at")
  blob       Blob     @relation(fields: [blobId], references: [id], onDelete: Cascade)

  @@id([blobId, chunkIndex])
  @@map("blob_chunks")
}
